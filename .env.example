# WebDAV backup used by the app's sync and by scripts/backup.mjs.
# Copy to .env (never committed) and fill in.
LIFELOG_WEBDAV_URL=https://dav.example.com/dav/
LIFELOG_WEBDAV_USERNAME=
# For Nutstore (坚果云) this is the app password generated for third-party apps, not the login password.
LIFELOG_WEBDAV_PASSWORD=
# Remote folder under the URL; the app writes <folder>/lifelog.sqlite
LIFELOG_WEBDAV_DIRECTORY=lifelog
